# Applied on top of arm64 defconfig + aruhier.config.
# prepare() fails if any of these doesn't survive the merge.

# Arch ships firmware as .zst
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Storage
CONFIG_DM_CRYPT=m
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_NTFS_FS=m
CONFIG_CHR_DEV_SG=m
CONFIG_BLK_DEV_SR=m
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m

# Networking: wireguard/VPN policy routing, firewall matches, iwd
CONFIG_WIREGUARD=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# nftables: Arch's iptables is iptables-nft (tailscale, docker, firewalld)
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m

# Bluetooth audio, input and networking (bnep)
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_LE=y
CONFIG_UHID=m

# External input devices and USB serial adapters
CONFIG_HIDRAW=y
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_APPLE=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_LENOVO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_USB_SERIAL_CH341=m

# Camera: the Slim 7x sensor is an OV02C10 (libcamera)
CONFIG_VIDEO_OV02C10=m
CONFIG_UDMABUF=y

# Memory pressure and cgroups: systemd-oomd needs PSI, IOWeight= needs iocost
CONFIG_PSI=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_BLK_CGROUP_IOCOST=y

# No debug info: much faster builds. Drops BTF (and sched_ext, which needs
# it) from aruhier.config; arm64 defconfig's reduced debug info rules BTF
# out anyway.
CONFIG_DEBUG_INFO_NONE=y

# Misc
CONFIG_BINFMT_MISC=m
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_KPROBES=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_COMPRESS_ALL=y
CONFIG_DYNAMIC_DEBUG=y
