# Applied on top of arm64 defconfig + aruhier.config.
# prepare() fails if any of these doesn't survive the merge.

# Arch ships firmware as .zst
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Storage
CONFIG_DM_CRYPT=m
CONFIG_ZRAM=m
CONFIG_NTFS_FS=m

# Networking: wireguard/VPN policy routing, firewall matches, iwd
CONFIG_WIREGUARD=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_CRYPTO_USER_API_HASH=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m

# nftables: Arch's iptables is iptables-nft (tailscale, docker, firewalld)
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m

# Bluetooth audio and input
CONFIG_BT_RFCOMM=m
CONFIG_BT_LE=y
CONFIG_UHID=m

# Camera (libcamera)
CONFIG_VIDEO_OV5675=m
CONFIG_UDMABUF=y

# No debug info: much faster builds. Drops BTF (and sched_ext, which needs
# it) from aruhier.config; arm64 defconfig's reduced debug info rules BTF
# out anyway.
CONFIG_DEBUG_INFO_NONE=y

# Misc
CONFIG_BINFMT_MISC=m
CONFIG_SECURITY_LANDLOCK=y
CONFIG_DYNAMIC_DEBUG=y
