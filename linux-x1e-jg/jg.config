# Applied after x1e.config, for what Jens' tree names differently from
# aruhier's. prepare() fails if any of these doesn't survive the merge.

# aruhier.config enables aruhier's EC_QCOM_HAMOA; Jens' DT binds this one
CONFIG_EC_LENOVO_YOGA_SLIM7X=m

# Ubuntu's out-of-tree EtherCAT master is default m and uses a gcc-only
# warning flag, so it breaks the clang build
# CONFIG_IGH_ECAT is not set
